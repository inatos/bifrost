# syntax=docker/dockerfile:1

FROM rust:1.90-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p bifrost_signal

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/bifrost_signal /usr/local/bin/bifrost_signal
ENV BIND_ADDR=0.0.0.0 PORT=8787
EXPOSE 8787
CMD ["bifrost_signal"]
