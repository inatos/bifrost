# Example env for Bifrost.
# Copy to `.env` before `docker compose up`.

# Public hostname (standalone Caddy mode)
BIFROST_HOST=bifrost.example.com
PUBLIC_ORIGIN=https://bifrost.example.com
PUBLIC_WS_ORIGIN=wss://bifrost.example.com/signal

# Only needed when Bifrost runs its own Caddy (not edge mode):
# ACME_EMAIL=ops@example.com

# Optional Coturn REST credentials (required for cross-NAT WebRTC)
# TURN_SECRET=generate-with-openssl-rand-hex-32
# EXTERNAL_IP=203.0.113.10
# TURN_URLS=turn:bifrost.example.com:3478?transport=udp,turn:bifrost.example.com:3478?transport=tcp
# Then: docker compose --profile turn -f docker-compose.yml -f docker-compose.edge.yml up -d

# Edge mode (shared VPS with Arathyll Caddy):
#   docker compose -f docker-compose.yml -f docker-compose.edge.yml up -d --build
# ACME_EMAIL / BIFROST_HOST unused for TLS; PUBLIC_* still required for room URLs.
