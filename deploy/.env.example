# Example env for Bifrost.
# Copy to `.env` before `docker compose up`.

# Public hostname / room URLs (required)
BIFROST_HOST=bifrost.arathyll.com
PUBLIC_ORIGIN=https://bifrost.arathyll.com
PUBLIC_WS_ORIGIN=wss://bifrost.arathyll.com/signal

# --- Shared Arathyll VPS (recommended) ---------------------------------------
# Pin BOTH compose files so plain `docker compose up` always attaches
# web/signal to arathyll_edge as bifrost_web / bifrost_signal.
# Omitting edge.yml is what caused Caddy 502s (lookup bifrost_web failed).
COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml

# Only needed when Bifrost runs its own Caddy (NOT edge mode):
# ACME_EMAIL=ops@example.com
# And remove/comment COMPOSE_FILE above, then: docker compose -f docker-compose.yml up -d

# Coturn REST (required for cross-NAT / Lab iframe Ready Up)
# TURN_SECRET=generate-with-openssl-rand-hex-32
# EXTERNAL_IP=203.0.113.10
# TURN_URLS=turn:bifrost.arathyll.com:3478?transport=udp,turn:bifrost.arathyll.com:3478?transport=tcp
# Then: docker compose --profile turn up -d
