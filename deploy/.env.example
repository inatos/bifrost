# Example production env for `docker compose` in this directory.
# Copy to `.env` and replace placeholders before `docker compose up`.

BIFROST_HOST=bifrost.example.com
PUBLIC_ORIGIN=https://bifrost.example.com
PUBLIC_WS_ORIGIN=wss://bifrost.example.com/signal
ACME_EMAIL=ops@example.com

# Optional Coturn REST credentials
# TURN_SECRET=
# TURN_URLS=turn:turn.example.com:3478?transport=udp
