# syntax=docker/dockerfile:1

FROM rust:1.90-bookworm AS builder
WORKDIR /app
# cargo-install trunk pulls lightningcss that currently fails on this image;
# use the official prebuilt binary instead.
ARG TRUNK_VERSION=0.21.14
RUN curl -fsSL "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-x86_64-unknown-linux-gnu.tar.gz" \
	| tar -xz -C /usr/local/bin \
	&& chmod +x /usr/local/bin/trunk \
	&& trunk --version
RUN rustup target add wasm32-unknown-unknown
COPY . .
RUN trunk build --release
# Expose wasm-bindgen exports before init() so shell.js can call lobby APIs as soon as the module loads.
RUN python3 deploy/patch_wasm_bindings.py


FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 8080
