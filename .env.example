# Bifrost environment template — copy to `.env` for deploy/

PUBLIC_ORIGIN=https://bifrost.arathyll.com
ACME_EMAIL=you@example.com
ROOM_TTL_SECS=900

# Coturn long-term credential secret (optional but recommended for NAT traversal)
TURN_SECRET=
TURN_URLS=turn:turn.arathyll.com:3478?transport=udp
TURN_TTL_SECS=600

RUST_LOG=bifrost_signal=info,tower_http=info
